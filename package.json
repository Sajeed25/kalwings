    "postinstall": "prisma generate",
    "test:unit": "tsx e2e/unit.ts",
    "test:a11y": "node e2e/a11y.mjs",
    "test:access": "node e2e/access.mjs",
    "docs:db": "node scripts/gen-db-docs.mjs",
    "docs:api": "node scripts/gen-api-docs.mjs",
    "backup": "node scripts/backup-db.mjs",
    "test:e2e": "node e2e/platform.mjs",
    "test:e2e:prod": "node e2e/production.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.1.1",
    "bcryptjs": "^2.4.3",
