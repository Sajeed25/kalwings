  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/embed-migrations.mjs",
    "build": "next build",
    "start": "prisma migrate deploy && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
