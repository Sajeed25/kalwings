    "clsx": "^2.1.1",
    "jose": "^5.10.0",
    "lucide-react": "^1.61.0",
    "next": "15.1.6",
    "nodemailer": "^7.0.13",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.12",
