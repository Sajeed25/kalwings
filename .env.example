# ── Required ────────────────────────────────────────────────────────────
# Your public URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://kalwings.com

# MySQL / MariaDB connection string (Hostinger hPanel → Databases → MySQL).
# URL-encode special characters in the password (@ → %40, # → %23, / → %2F).
DATABASE_URL=mysql://user:password@localhost:3306/kalwings?connection_limit=5

# Random secret, 32+ chars. Generate:  openssl rand -base64 48
AUTH_SECRET=

# Email for sign-in codes, sent over SMTP from a Hostinger mailbox. REQUIRED in production,
# otherwise nobody can log in. Create the mailbox in hPanel > Emails (e.g. hello@kalwings.com).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@kalwings.com
SMTP_PASSWORD=
# Must be that mailbox (or one of its aliases).
EMAIL_FROM=hello@kalwings.com
# Where contact-form messages are emailed (defaults to EMAIL_FROM). They are always stored in the database too.
CONTACT_TO=
# EMAIL_API_URL=   (test-only: POST mail as JSON to this URL instead of SMTP)

# Comma-separated emails that become PLATFORM_ADMIN when they sign in (your own email).
ADMIN_EMAILS=

# Code execution for coding assessments. Point at an ISOLATED Judge0-compatible service (never run untrusted code on this server).
# Leave empty to keep coding assessments switched off; written assessments still work.
SANDBOX_URL=
SANDBOX_TOKEN=

# ── Optional / not wired yet ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OTP_PROVIDER_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_ID=
